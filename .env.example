# ============================================
# תבנית משתני סביבה
# העתק אותי ל-.env ומלא ערכים אמיתיים:
#   cp .env.example .env
# הקובץ .env לא נכנס ל-Git!
# ============================================

# --- Django ---
SECRET_KEY=REPLACE_ME_WITH_A_REAL_SECRET_KEY
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=blog_db
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
DB_HOST=localhost
DB_PORT=5432

# --- CORS (כתובות צד הלקוח ב-React) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
